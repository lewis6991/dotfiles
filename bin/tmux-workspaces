#!/usr/bin/env python3

from pathlib import Path
import fcntl
import os
import subprocess
import sys

_MIN_CELL_WIDTH = 24
_MAX_CELL_WIDTH = 48


def _run(*cmd: str) -> str:
    env = os.environ | {'GIT_OPTIONAL_LOCKS': '0'}
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=6)
    except (OSError, subprocess.TimeoutExpired):
        return ''
    return result.stdout if result.returncode == 0 else ''


def _git(path: str, *args: str) -> str:
    return _run('git', '-c', 'core.fsmonitor=false', '-C', path, *args)


def _shorten(text: str, width: int = 22) -> str:
    if len(text) <= width:
        return text
    left = (width - 1) // 2
    right = width - left - 1
    return f'{text[:left]}…{text[-right:]}'


def _center(text: str, width: int) -> str:
    return _shorten(text, width).center(width)


def _truncate(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    return f'{text[:width - 1]}…'


def _state_cell(state: str, agent: str, width: int) -> str:
    if not agent:
        return _center(state, width)
    if not state:
        return _center(agent, width)

    agent_width = min(len(agent), 12)
    state = _shorten(state, width - agent_width - 3)
    agent = _truncate(agent, width - len(state) - 3)
    return f'{state} · {agent}'.center(width)


def _cell_width(session: str) -> int:
    layout = _run(
        'tmux',
        'display-message',
        '-p',
        '-t',
        session,
        '#{session_windows}\t#{status-left-length}\t#{status-right-length}',
    ).strip()
    clients = _run('tmux', 'list-clients', '-t', session, '-F', '#{client_width}')
    try:
        windows, left, right = map(int, layout.split('\t'))
        client_width = min(map(int, clients.splitlines()))
        width = (client_width - left - right) // windows
    except (ValueError, ZeroDivisionError):
        return 32
    return min(_MAX_CELL_WIDTH, max(_MIN_CELL_WIDTH, width))


def _window_name(name: str, path: str, zoomed: str, activity: str) -> str:
    parts = Path(path).parts
    managed = False
    if 'worktrees' in parts:
        worktrees = parts.index('worktrees')
        if worktrees + 2 < len(parts) and parts[worktrees - 1] == '.codex':
            name = f'{parts[worktrees + 2]}@{parts[worktrees + 1]}'
            managed = True
    if not managed:
        name = name.split('#[', 1)[0]
    flags = (' Z' if zoomed == '1' else '') + (' !' if activity == '1' else '')
    return f'{name}{flags}'


def _git_state(path: str) -> tuple[str, str]:
    output = _git(
        path,
        'status',
        '--porcelain=v2',
        '--branch',
        '--untracked-files=normal',
    )
    if not output:
        return _shorten(Path(path).name), 'colour8'

    oid = ''
    branch = ''
    dirty = conflicts = False
    for line in output.splitlines():
        if line.startswith('# branch.oid '):
            oid = line.removeprefix('# branch.oid ')
        elif line.startswith('# branch.head '):
            branch = line.removeprefix('# branch.head ')
        elif line.startswith('u '):
            dirty = conflicts = True
        elif not line.startswith('# '):
            dirty = True

    detached = branch == '(detached)'
    label = f'@{oid[:8]}' if detached else branch
    if conflicts:
        colour = 'colour1'
    elif detached:
        colour = 'colour5'
    elif dirty:
        colour = 'colour3'
    else:
        colour = 'colour8'
    return label, colour


def _agent_summary(counts: dict[str, int], omp_titles: list[str]) -> str:
    agents: list[str] = []
    if count := counts.get('codex', 0):
        agents.append(f'codex×{count}' if count > 1 else 'codex')
    if count := counts.get('omp', 0):
        omp = omp_titles[0] if omp_titles else 'omp'
        agents.append(f'{count}× {omp}' if count > 1 else omp)
    return ' + '.join(agents)


def main() -> None:
    if len(sys.argv) > 2 and sys.argv[1] == '--pane':
        target = sys.argv[2]
        location = _run(
            'tmux',
            'display-message',
            '-p',
            '-t',
            target,
            '#{session_name}\t#{window_id}',
        ).strip()
        if not location:
            return
        session, window = location.split('\t', 1)
    else:
        session = sys.argv[1] if len(sys.argv) > 1 else ''
        window = sys.argv[2] if len(sys.argv) > 2 else ''

    lock = open(f'/tmp/tmux-workspaces-{os.getuid()}.lock', 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    target = f'{session}:{window}' if window else session
    cell_width = _cell_width(session)
    fmt = (
        '#{window_index}\t#{window_active}\t#{pane_current_path}\t'
        '#{window_name}\t#{window_zoomed_flag}\t'
        '#{window_activity_flag}'
    )
    if window:
        output = _run('tmux', 'display-message', '-p', '-t', target, fmt)
        pane_scope = ()
    else:
        output = _run('tmux', 'list-windows', '-t', session, '-F', fmt)
        pane_scope = ('-s',)
    pane_output = _run(
        'tmux',
        'list-panes',
        *pane_scope,
        '-t',
        target,
        '-F',
        '#{window_index}\t#{pane_current_path}\t#{pane_current_command}\t#{pane_title}',
    )
    agents: dict[str, dict[str, int]] = {}
    omp_titles: dict[str, list[str]] = {}
    pane_roots: dict[str, set[str]] = {}
    root_cache: dict[str, str] = {}
    for line in pane_output.splitlines():
        index, path, command, title = line.split('\t', 3)
        if command in {'codex', 'omp'}:
            counts = agents.setdefault(index, {})
            counts[command] = counts.get(command, 0) + 1
        if command == 'omp' and title.startswith('π:'):
            omp_titles.setdefault(index, []).append(title.removeprefix('π:').strip())
        if path not in root_cache:
            root_cache[path] = _git(path, 'rev-parse', '--show-toplevel').strip()
        if root := root_cache[path]:
            pane_roots.setdefault(index, set()).add(root)

    states: dict[str, tuple[str, str]] = {}
    for line in output.splitlines():
        index, _, path, name, zoomed, activity = line.split('\t', 5)
        roots = pane_roots.get(index, set())
        root = next(iter(roots)) if len(roots) == 1 else ''
        if root:
            if root not in states:
                states[root] = _git_state(root)
            state, colour = states[root]
        else:
            state = f'{len(roots)} repos' if len(roots) > 1 else ''
            colour = 'colour8'
        agent = _agent_summary(agents.get(index, {}), omp_titles.get(index, []))
        target = f'{session}:{index}'
        _run('tmux', 'set-option', '-wq', '-t', target, '@workspace_name',
             _center(f'{index} {_window_name(name, path, zoomed, activity)}', cell_width - 2))
        _run('tmux', 'set-option', '-wq', '-t', target, '@workspace_state',
             _state_cell(state, agent, cell_width))
        _run('tmux', 'set-option', '-wq', '-t', target, '@workspace_colour', colour)


if __name__ == '__main__':
    main()
