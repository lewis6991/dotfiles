#!/usr/bin/env bash

set -e

force=false
case ${1-} in
    -f|--force)
        force=true
        shift
        ;;
esac

if (($# == 0)); then
    echo "usage: git bd [-f|--force] <branch>..." >&2
    exit 2
fi

for branch; do
    worktree=$(git branch --list "$branch" --format='%(worktreepath)')
    if [[ -n $worktree ]]; then
        if ! $force; then
            read -r -p "Warning: branch '$branch' is attached to worktree '$worktree'. Delete both? [y/N] " reply
            [[ $reply =~ ^[Yy]([Ee][Ss])?$ ]] || continue
        fi
        if [[ -e $worktree/.git ]]; then
            git worktree remove --force "$worktree"
        else
            # Git cannot remove a registration after the worktree's .git file is gone.
            git worktree prune --expire now
        fi
    fi

    git branch -D -- "$branch"
done
