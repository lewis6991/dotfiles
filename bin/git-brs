#! /usr/bin/env python3
"""
This module provides utilities for displaying information about Git branches,
pull requests (PRs), and Gerrit code reviews in a formatted and colorized manner.
It integrates with GitHub CLI (`gh`) and Gerrit via SSH to fetch metadata about
branches, PRs, and code review approvals, and prints them with enhanced formatting
for terminal output, including hyperlinks and color codes.
"""

from __future__ import annotations

from concurrent.futures import Future
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from dataclasses import field
from functools import cached_property
from functools import lru_cache
from os.path import relpath
from pathlib import Path
import re
import shlex
import json
import argparse
import shutil
import sys

import subprocess

from typing import ClassVar
from typing import NotRequired
from typing import TypedDict
from typing import cast
from enum import StrEnum

_THIS = '\uf111'


class _Ansi(StrEnum):
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    MAGENTA = '\033[95m'
    RED = '\033[91m'
    END = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'
    GREY = '\033[90m'

    # hyperlinks
    OSC8_1 = '\033]8;;'
    OSC8_2 = '\033\\'
    OSC8_3 = '\033]8;;\033\\'


_MERGED_STYLE = f'{_Ansi.BOLD}{_Ansi.CYAN}'
_OSC_RE = re.compile(r'\033\].*?(?:\a|\033\\)')
_CSI_RE = re.compile(r'\033\[[0-?]*[ -/]*[@-~]')


def _run(cmd: str | list[str]) -> str:
    if isinstance(cmd, str):
        cmd = shlex.split(cmd)
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout.rstrip('\n')


def _link(text: str, url: str) -> str:
    return f'{_Ansi.UNDERLINE}{_Ansi.OSC8_1}{url}{_Ansi.OSC8_2}{text}{_Ansi.OSC8_3}{_Ansi.END}'


@lru_cache(maxsize=None)
def _resolve_ref_oid(ref: str) -> str | None:
    if not ref:
        return None
    result = subprocess.run(
        ['git', 'rev-parse', '--verify', ref],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def _branch_oids(branch_name: str, upstream: str) -> set[str]:
    refs = [f'refs/heads/{branch_name}']
    if upstream:
        refs.append(upstream)
    return {oid for ref in refs if (oid := _resolve_ref_oid(ref))}


@dataclass
class _Gerrit:
    _host: str
    _port: ClassVar[int] = 29418
    _query_cache: dict[str, list[_Gerrit.QueryResult]] = field(default_factory=dict, init=False)
    _change_cache: dict[str, list[_Gerrit.QueryResult]] = field(default_factory=dict, init=False)
    _change_id_re: ClassVar[re.Pattern[str]] = re.compile(r'^I[a-f0-9]{40}$', re.IGNORECASE)
    _batch_size: ClassVar[int] = 16
    _url_re: ClassVar[re.Pattern[str]] = re.compile(r'https?://\S+')
    _patch_set_header_re: ClassVar[re.Pattern[str]] = re.compile(
        r'^Patch Set (?P<patchset>\d+):(?: (?P<detail>.*))?$'
    )
    _label_vote_re: ClassVar[re.Pattern[str]] = re.compile(
        r'^(?P<label>[A-Za-z0-9][A-Za-z0-9-]*?)(?P<value>[+-]\d+)$'
    )
    _label_removed_re: ClassVar[re.Pattern[str]] = re.compile(
        r'^-(?P<label>[A-Za-z0-9][A-Za-z0-9-]*)$'
    )

    class User(TypedDict):
        name: str
        email: str
        username: str

    class Approval(TypedDict):
        type: str
        value: str
        grantedOn: int
        by: _Gerrit.User

    class ReviewComment(TypedDict):
        timestamp: int
        reviewer: _Gerrit.User
        message: str

    class PatchSet(TypedDict):
        number: int
        revision: str
        parent: list[str]
        ref: str
        uploader: _Gerrit.User
        author: _Gerrit.User
        createdOn: int
        kind: str
        sizeInsertions: int
        sizeDeletions: int

    class CurrentPatchSet(PatchSet):
        approvals: list[_Gerrit.Approval]

    class QueryResult(TypedDict):
        id: str
        url: str
        currentPatchSet: _Gerrit.CurrentPatchSet
        patchSets: list[_Gerrit.PatchSet]
        comments: list[_Gerrit.ReviewComment]
        number: int
        project: str
        subject: str
        status: str
        wip: NotRequired[bool]

    @staticmethod
    def get_change_id(commit_body: list[str]) -> str | None:
        for line in commit_body:
            if m := re.search('Change-Id: (.*)', line):
                return m.group(1)
        return None

    @staticmethod
    def _origin_host() -> str | None:
        try:
            url = _run('git config --get remote.origin.url').strip()
        except subprocess.CalledProcessError:
            return None
        if match := re.match(r'(?:ssh://)?(?:[^@]+@)?([^:/]+)', url):
            host = match.group(1)
        else:
            host = url.split(':')[0]
        if 'gerrit' not in host:
            return None
        return host

    @staticmethod
    def origin_base_url() -> str | None:
        if host := _Gerrit._origin_host():
            return f'https://{host}'
        return None

    @cached_property
    def remote_name(self) -> str:
        try:
            lines = _run(['git', 'remote', '-v']).splitlines()
        except subprocess.CalledProcessError:
            return 'origin'
        for line in lines:
            parts = line.split()
            if len(parts) < 2:
                continue
            remote, url = parts[:2]
            if match := re.match(r'(?:ssh://)?(?:[^@]+@)?([^:/]+)', url):
                host = match.group(1)
            else:
                host = url.split(':')[0]
            if host == self._host:
                return remote
        return 'origin'

    @staticmethod
    def _approval_key(approval: _Gerrit.Approval) -> tuple[str, str, str, int]:
        return (
            approval['type'],
            approval['value'],
            _Gerrit._user_key(approval['by']),
            approval.get('grantedOn', 0),
        )

    @staticmethod
    def _approval_url_refs(
        approval: _Gerrit.Approval,
        approval_urls: dict[tuple[str, str, str, int], tuple[str, ...]],
    ) -> tuple[str, ...]:
        return approval_urls.get(_Gerrit._approval_key(approval), ())

    @staticmethod
    def _approval_urls(
        result: _Gerrit.QueryResult,
    ) -> dict[tuple[str, str, str, int], tuple[str, ...]]:
        current_patchset = result['currentPatchSet']['number']
        comments: list[tuple[int, str, set[tuple[str, str | None]], tuple[str, ...]]] = []
        for comment in result.get('comments', []):
            patchset, votes = _Gerrit._comment_votes(comment['message'])
            if patchset != current_patchset:
                continue
            urls = _Gerrit._message_urls(comment['message'])
            if not urls:
                continue
            reviewer_key = _Gerrit._user_key(comment['reviewer'])
            if not reviewer_key:
                continue
            comments.append((comment['timestamp'], reviewer_key, votes, urls))
        comments.sort(key=lambda item: item[0])

        approval_urls: dict[tuple[str, str, str, int], tuple[str, ...]] = {}
        for approval in result['currentPatchSet'].get('approvals', []):
            approval_key = _Gerrit._approval_key(approval)
            approval_vote = (approval['type'], approval['value'])
            for _, reviewer_key, votes, urls in reversed(comments):
                if approval_vote not in votes:
                    continue
                if approval_key[2] != reviewer_key:
                    continue
                approval_urls[approval_key] = urls
                break
        return approval_urls

    @staticmethod
    def _comment_votes(message: str) -> tuple[int | None, set[tuple[str, str | None]]]:
        header = message.splitlines()[0].strip() if message else ''
        if not (match := _Gerrit._patch_set_header_re.match(header)):
            return None, set()

        patchset = int(match.group('patchset'))
        detail = (match.group('detail') or '').strip()
        if not detail:
            return patchset, set()

        votes: list[tuple[str, str | None]] = []
        for token in detail.split():
            if vote_match := _Gerrit._label_vote_re.fullmatch(token):
                votes.append((vote_match.group('label'), str(int(vote_match.group('value')))))
                continue
            if removed_match := _Gerrit._label_removed_re.fullmatch(token):
                votes.append((removed_match.group('label'), None))
                continue
            return patchset, set()
        return patchset, set(votes)

    @staticmethod
    def _fmt_label(
        label: str,
        approvals: list[_Gerrit.Approval],
        approval_urls: dict[tuple[str, str, str, int], tuple[str, ...]],
    ) -> str:
        label_abbr = _Gerrit._label_token(label)
        values = ', '.join(_Gerrit._approval_summary(approval) for approval in approvals)
        urls = _Gerrit._approval_url_refs(approvals[0], approval_urls) if len(approvals) == 1 else ()
        fail = any(int(approval['value']) < 0 for approval in approvals)
        if fail:
            text = f'{label_abbr}[{values}{_Ansi.RED}]'
            text = _Gerrit._link_targets(text, urls, _Ansi.RED)
            return f'{_Ansi.RED}{text}{_Ansi.END}'

        text = f'{label_abbr}[{len(approvals)}]'
        text = _Gerrit._link_targets(text, urls, _Ansi.GREEN)
        return f'{_Ansi.GREEN}{text}{_Ansi.END}'

    @staticmethod
    def _approval_name(approval: _Gerrit.Approval) -> str:
        username = approval['by'].get('username', '')
        if username:
            return username
        return approval['by']['name'].split()[0].lower()

    @staticmethod
    def _message_urls(message: str) -> tuple[str, ...]:
        urls: list[str] = []
        for match in _Gerrit._url_re.findall(message):
            url = match.rstrip('.,)')
            if url and url not in urls:
                urls.append(url)
        return tuple(urls)

    @staticmethod
    def _link_targets(text: str, urls: tuple[str, ...], color: str) -> str:
        if not urls:
            return text
        if len(urls) == 1:
            return _link(text, urls[0])
        suffix = ''.join(
            f'{color}{_link(f"<{index}>", url)}{_Ansi.END}'
            for index, url in enumerate(urls, start=1)
        )
        return f'{text}{suffix}'

    @staticmethod
    def _approval_summary(approval: _Gerrit.Approval) -> str:
        value = int(approval['value'])
        name = approval['by']['name']
        color = _Ansi.GREEN if value > 0 else _Ansi.RED
        summary = f'{value:+d}' if value > 0 else f'{value} ({name})'
        return f'{color}{summary}'

    @staticmethod
    def _label_token(label: str) -> str:
        return ''.join(part[0].lower() for part in label.split('-') if part)

    @staticmethod
    def _approval_token(
        label: str,
        approval: _Gerrit.Approval,
        approval_urls: dict[tuple[str, str, str, int], tuple[str, ...]],
    ) -> str:
        value = int(approval['value'])
        token = f'{_Gerrit._label_token(label)}{value:+d}'
        if value < 0:
            token += f'({_Gerrit._approval_name(approval)})'
        color = _Ansi.GREEN if value > 0 else _Ansi.RED
        token = _Gerrit._link_targets(
            token,
            _Gerrit._approval_url_refs(approval, approval_urls),
            color,
        )
        return f'{color}{token}{_Ansi.END}'

    @staticmethod
    def _user_key(user: _Gerrit.User) -> str:
        for field in ('username', 'email', 'name'):
            if value := user.get(field, ''):
                return value.casefold()
        return ''

    @staticmethod
    def _status_tokens(result: _Gerrit.QueryResult) -> list[str]:
        tokens: list[str] = []
        if result.get('wip'):
            tokens.append(f'{_Ansi.BOLD}{_Ansi.MAGENTA}wip{_Ansi.END}')
        match result['status']:
            case 'NEW':
                pass
            case x:
                status_color = _MERGED_STYLE if x == 'MERGED' else _Ansi.BLUE
                tokens.append(f'{status_color}{x.lower()}{_Ansi.END}')
        return tokens

    def _line_for_result(self, result: _Gerrit.QueryResult, sha: str | None = None) -> list[str]:
        lines: list[str] = []
        currentps = result['currentPatchSet']['number']
        patchset = '?'
        if sha is not None:
            for ps in result['patchSets']:
                if ps['revision'] == sha:
                    patchset = ps['number']
                    break
        else:
            lines.append(f'{_Ansi.YELLOW}{result["project"]}:{_Ansi.END}')
            lines.append(f'      {_Ansi.BLUE}{result["subject"]}{_Ansi.END}')

        ln = _link(str(result['number']), result['url'])
        if sha is not None:
            line = f'      {_Ansi.CYAN}{_Ansi.BOLD}gr{_Ansi.END} {ln} '
        else:
            line = f'      └ {ln} '

        if sha is not None:
            color = _Ansi.GREEN if result['currentPatchSet']['revision'] == sha else _Ansi.RED
            line += f'{color}{patchset}/{currentps}{_Ansi.END}'
        else:
            line += f'{_Ansi.BLUE}ps {currentps}{_Ansi.END}'

        if status_tokens := self._status_tokens(result):
            sep = ' ' if sha is not None else ', '
            line += sep + ', '.join(status_tokens)

        approvals_by_label: dict[str, list[_Gerrit.Approval]] = {}
        for approval in result['currentPatchSet'].get('approvals', []):
            approvals_by_label.setdefault(approval['type'], []).append(approval)
        approval_urls = _Gerrit._approval_urls(result)

        if sha is not None:
            approval_tokens: list[str] = []
            for label in sorted(approvals_by_label):
                approvals = sorted(
                    approvals_by_label[label],
                    key=lambda approval: (
                        -int(approval['value']),
                        _Gerrit._approval_name(approval),
                    ),
                )
                positive_approvals: dict[int, list[_Gerrit.Approval]] = {}
                negative_approvals: list[_Gerrit.Approval] = []
                for approval in approvals:
                    value = int(approval['value'])
                    if value > 0:
                        positive_approvals.setdefault(value, []).append(approval)
                    else:
                        negative_approvals.append(approval)
                for value in sorted(positive_approvals, reverse=True):
                    approvals_for_value = positive_approvals[value]
                    count = len(approvals_for_value)
                    token = f'{_Gerrit._label_token(label)}{value:+d}'
                    if count > 1:
                        token += f'x{count}'
                    if count == 1:
                        token = _Gerrit._link_targets(
                            token,
                            _Gerrit._approval_url_refs(approvals_for_value[0], approval_urls),
                            _Ansi.GREEN,
                        )
                    approval_tokens.append(f'{_Ansi.GREEN}{token}{_Ansi.END}')
                approval_tokens.extend(
                    _Gerrit._approval_token(label, approval, approval_urls)
                    for approval in negative_approvals
                )
            if approval_tokens:
                line += ' ' + ' '.join(approval_tokens)
        else:
            labels = ', '.join(
                _Gerrit._fmt_label(label, approvals, approval_urls)
                for label, approvals in approvals_by_label.items()
            )
            if labels:
                line += f', {labels}'
        lines.append(line)
        return lines

    def _query(self, query: str) -> list[_Gerrit.QueryResult]:
        if query in self._query_cache:
            return self._query_cache[query]

        lines = _run(
            [
                'ssh',
                self._host,
                '-p',
                str(self._port),
                'gerrit',
                'query',
                query,
                '--current-patch-set',
                '--patch-sets',
                '--comments',
                '--format=JSON',
            ]
        ).splitlines()
        results: list[_Gerrit.QueryResult] = []
        for line in lines:
            obj = cast(dict[str, object], json.loads(line))
            if obj.get('type') == 'stats':
                continue
            results.append(cast(_Gerrit.QueryResult, cast(object, obj)))
        self._query_cache[query] = results
        return results

    def _query_change_id(self, change_id: str) -> list[_Gerrit.QueryResult]:
        if change_id not in self._change_cache:
            self._cache_change_results(self._query(f'change:{change_id}'))
            self._change_cache.setdefault(change_id, [])
        return self._change_cache[change_id]

    def _cache_change_results(self, results: list[_Gerrit.QueryResult]) -> None:
        for result in results:
            if change_id := result.get('id'):
                self._change_cache[change_id] = [result]

    def prefetch_change_ids(self, change_ids: list[str]) -> None:
        pending = [
            change_id
            for change_id in dict.fromkeys(change_ids)
            if change_id not in self._change_cache
        ]
        for i in range(0, len(pending), self._batch_size):
            chunk = pending[i : i + self._batch_size]
            query = ' OR '.join(f'change:{change_id}' for change_id in chunk)
            self._cache_change_results(self._query(query))
            for change_id in chunk:
                self._change_cache.setdefault(change_id, [])

    def info_lines(self, query: str, sha: str | None = None) -> list[str]:
        lines: list[str] = []
        results = (
            self._query_change_id(query)
            if self._change_id_re.fullmatch(query)
            else self._query(query)
        )
        for result in results:
            lines.extend(self._line_for_result(result, sha))
        return lines

    def info(self, query: str, sha: str | None = None):
        for line in self.info_lines(query, sha):
            print(line)

    def open_change_results(self) -> list[_Gerrit.QueryResult]:
        results = self._query('owner:me is:open')
        self._cache_change_results(results)
        return results

    @staticmethod
    def init() -> _Gerrit | None:
        host = _Gerrit._origin_host()
        if not host:
            return

        try:
            _ = _run(f'ssh {host} -p {_Gerrit._port} gerrit version')
            return _Gerrit(host)
        except subprocess.CalledProcessError:
            pass


class _Github:
    _branch_cache_key_prefix: ClassVar[str] = 'branch.'
    _branch_pr_number_key_suffix: ClassVar[str] = '.pr-number'
    _pr_cache_key_prefix: ClassVar[str] = 'git-brs.pr-'
    _pr_cache_fields: ClassVar[set[str]] = {'url', 'title', 'state', 'draft', 'base', 'oid'}
    _unresolved_comments_query: ClassVar[str] = """
query($owner: String!, $name: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $pr) {
      reviewThreads(first: 100, after: $endCursor) {
        nodes {
          isResolved
          comments(first: 1) {
            totalCount
          }
        }
        pageInfo {
          hasNextPage
          endCursor
        }
      }
    }
  }
}
"""
    _repo_name_with_owner: str

    @dataclass
    class CheckSummary:
        token: str
        detail: str | None = None

    class Check(TypedDict):
        bucket: str
        link: str
        name: str
        state: str

    @dataclass
    class CachedPR:
        number: int | None = None
        url: str | None = None
        isDraft: bool = False
        state: str = 'OPEN'
        baseRefName: str | None = None
        headRefOid: str | None = None
        title: str = ''

    class PR(TypedDict):
        headRefName: str
        headRefOid: str | None
        url: str
        isDraft: bool
        state: str
        number: int
        baseRefName: str
        title: str
        updatedAt: str

    def __init__(self, repo_name_with_owner: str) -> None:
        self._repo_name_with_owner = repo_name_with_owner

    @cached_property
    def _repo_owner_name(self) -> tuple[str, str]:
        owner, _, name = self._repo_name_with_owner.partition('/')
        return owner, name

    @cached_property
    def _prs(self) -> list[_Github.PR]:
        try:
            r = _run(
                [
                    'gh',
                    'pr',
                    'list',
                    '--json=headRefName,headRefOid,url,isDraft,state,number,baseRefName,title,updatedAt',
                    '--state=all',
                    '--limit=300',
                    '--author=@me',
                ]
            )
            return cast(list[_Github.PR], json.loads(r))
        except subprocess.CalledProcessError as e:
            stderr = cast(str | None, e.stderr)
            if stderr:
                print(stderr)
            return []

    @cached_property
    def prs_by_head_ref(self) -> dict[str, list[_Github.PR]]:
        prs: dict[str, list[_Github.PR]] = {}
        for pr in self._prs:
            prs.setdefault(pr['headRefName'], []).append(pr)
        return prs

    @staticmethod
    def _remote_repo(url: str) -> str | None:
        stripped = url.rstrip('/')
        if stripped.endswith('.git'):
            stripped = stripped[:-4]
        if match := re.search(r'github\.com[:/]([^/]+/[^/]+?)(?:\.git)?(?:/|$)', stripped):
            return match.group(1)
        return None

    @cached_property
    def base_remote(self) -> str | None:
        return _remote_for_repo(self._repo_name_with_owner)

    @staticmethod
    def _pr_sort_key(pr: _Github.PR) -> tuple[int, str, int]:
        state_rank = {'OPEN': 2, 'MERGED': 1, 'CLOSED': 0}.get(pr['state'], 0)
        return (state_rank, pr['updatedAt'], pr['number'])

    def pr_for_branch(self, branch_name: str, upstream: str) -> _Github.PR | None:
        candidates = list(self.prs_by_head_ref.get(branch_name, []))
        if not candidates:
            return None

        branch_oids = _branch_oids(branch_name, upstream)
        if not branch_oids:
            return None
        candidates = [pr for pr in candidates if pr['headRefOid'] in branch_oids]
        if not candidates:
            return None

        return max(candidates, key=self._pr_sort_key)

    @staticmethod
    def _summarize_checks(checks: list[_Github.Check]) -> _Github.CheckSummary:
        if not checks:
            return _Github.CheckSummary(f'{_Ansi.GREY}-{_Ansi.END}')

        buckets = {check['bucket'] for check in checks}
        passed = sum(1 for check in checks if check['bucket'] == 'pass')
        failures: list[tuple[str, str | None]] = []
        for check in checks:
            if check['bucket'] not in {'fail', 'cancel'}:
                continue
            text = (
                f'{check["name"]} ({check["state"].lower()})'
                if check['bucket'] == 'cancel'
                else check['name']
            )
            failures.append((text, check.get('link')))
        if 'fail' in buckets or 'cancel' in buckets:
            if len(failures) == 1:
                failure_text, failure_url = failures[0]
                detail = f'{_Ansi.RED}{failure_text}{_Ansi.END}'
                if failure_url:
                    detail = _link(detail, failure_url)
                return _Github.CheckSummary(f'{_Ansi.RED}✗{_Ansi.END}', detail)
            detail = f'{_Ansi.RED}({passed}/{len(checks)}){_Ansi.END}'
            summary_url = failures[0][1] if failures else None
            if summary_url and (
                match := re.match(
                    r'^(https://github\.com/[^/]+/[^/]+/actions/runs/\d+)(?:/job/\d+)?$',
                    summary_url,
                )
            ):
                summary_url = match.group(1)
            if summary_url:
                detail = _link(detail, summary_url)
            return _Github.CheckSummary(
                f'{_Ansi.RED}✗{_Ansi.END}',
                detail,
            )
        if 'pending' in buckets:
            return _Github.CheckSummary(f'{_Ansi.YELLOW}…{_Ansi.END}')
        if 'pass' in buckets:
            return _Github.CheckSummary(f'{_Ansi.GREEN}✓{_Ansi.END}')
        if 'skipping' in buckets:
            return _Github.CheckSummary(f'{_Ansi.GREY}-{_Ansi.END}')
        return _Github.CheckSummary(f'{_Ansi.GREY}?{_Ansi.END}')

    def get_pr_checks(self, number: int) -> _Github.CheckSummary | None:
        result = subprocess.run(
            [
                'gh',
                'pr',
                'checks',
                str(number),
                '--json=bucket,link,name,state',
                '--required',
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        stderr = cast(str | None, result.stderr)
        if result.returncode not in (0, 8):
            if stderr and re.search(r"^no (?:required )?checks reported on the '.*' branch$", stderr.strip()):
                return None
            if stderr:
                print(stderr)
            return None
        return self._summarize_checks(cast(list[_Github.Check], json.loads(result.stdout or '[]')))

    def get_pr_unresolved_comments(self, number: int) -> int | None:
        owner, name = self._repo_owner_name
        try:
            pages = cast(
                list[dict[str, object]],
                json.loads(
                    _run(
                        [
                            'gh',
                            'api',
                            'graphql',
                            '--paginate',
                            '--slurp',
                            '-F',
                            f'owner={owner}',
                            '-F',
                            f'name={name}',
                            '-F',
                            f'pr={number}',
                            '-f',
                            f'query={self._unresolved_comments_query}',
                        ]
                    )
                    or '[]'
                ),
            )
        except subprocess.CalledProcessError as e:
            stderr = cast(str | None, e.stderr)
            if stderr:
                print(stderr)
            return None

        unresolved_comments = 0
        for page in pages:
            data = cast(dict[str, object], page.get('data') or {})
            repository = cast(dict[str, object], data.get('repository') or {})
            pull_request = cast(dict[str, object], repository.get('pullRequest') or {})
            review_threads = cast(dict[str, object], pull_request.get('reviewThreads') or {})
            nodes = cast(list[dict[str, object]], review_threads.get('nodes') or [])
            for node in nodes:
                if node.get('isResolved'):
                    continue
                comments = cast(dict[str, object], node.get('comments') or {})
                total_count = comments.get('totalCount')
                if isinstance(total_count, int):
                    unresolved_comments += total_count
        return unresolved_comments

    @staticmethod
    def format_pr_line(
        number: int,
        url: str,
        is_draft: bool,
        state: str,
        title: str,
        unresolved_comments: int | None = None,
        checks_summary: _Github.CheckSummary | None = None,
    ) -> str:
        tokens: list[str] = []
        if is_draft:
            tokens.append(f'{_Ansi.BLUE}draft{_Ansi.END}')
        elif state == 'MERGED':
            tokens.append(f'{_MERGED_STYLE}merged{_Ansi.END}')
        elif state != 'OPEN':
            tokens.append(f'{_Ansi.RED}{state.lower()}{_Ansi.END}')
        info_tokens: list[str] = []
        if unresolved_comments:
            info_tokens.append(f'{_Ansi.YELLOW}comments:{unresolved_comments}{_Ansi.END}')
        checks_tokens: list[str] = []
        if checks_summary:
            checks_tokens.append(checks_summary.token)
            if checks_summary.detail:
                checks_tokens.append(checks_summary.detail)

        ln = _link(f'#{number}', url)
        line = f'  {_Ansi.CYAN}{_Ansi.BOLD}gh{_Ansi.END} {ln}'
        if tokens:
            line += f' {" ".join(tokens)}'
        if title:
            line += f'  {_Ansi.BLUE}{title}{_Ansi.END}'
        if info_tokens:
            line += f' {" ".join(info_tokens)}'
        if checks_tokens:
            line += f' {" ".join(checks_tokens)}'
        return line

    @staticmethod
    def init() -> _Github | None:
        try:
            r = _run('gh repo view --json=nameWithOwner')
            repo = cast(dict[str, str], json.loads(r))
            github = _Github(repo['nameWithOwner'])
            _ = github.prs_by_head_ref
            return github
        except subprocess.CalledProcessError:
            return None

    @classmethod
    def cached_prs(cls, local_branches: set[str]) -> dict[str, _Github.CachedPR]:
        if not local_branches:
            return {}
        result = subprocess.run(
            [
                'git',
                'config',
                '--local',
                '--get-regexp',
                rf'^{re.escape(cls._branch_cache_key_prefix)}.*{re.escape(cls._branch_pr_number_key_suffix)}$',
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode not in (0, 1):
            return {}

        branch_numbers: dict[str, int] = {}
        for line in result.stdout.splitlines():
            key, _, value = line.partition(' ')
            if not key.startswith(cls._branch_cache_key_prefix):
                continue
            if not key.endswith(cls._branch_pr_number_key_suffix):
                continue
            branch = key[len(cls._branch_cache_key_prefix) : -len(cls._branch_pr_number_key_suffix)]
            if branch not in local_branches:
                continue
            try:
                branch_numbers[branch] = int(value.strip())
            except ValueError:
                continue

        if not branch_numbers:
            return {}

        result = subprocess.run(
            [
                'git',
                'config',
                '--local',
                '--get-regexp',
                rf'^{re.escape(cls._pr_cache_key_prefix)}[0-9]+\.',
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode not in (0, 1):
            return {branch: cls.CachedPR(number=number) for branch, number in branch_numbers.items()}

        cached_by_number = {
            number: cls.CachedPR(number=number) for number in set(branch_numbers.values())
        }
        for line in result.stdout.splitlines():
            key, _, value = line.partition(' ')
            if not key.startswith(cls._pr_cache_key_prefix):
                continue
            remainder = key[len(cls._pr_cache_key_prefix) :]
            number_str, sep, field = remainder.partition('.')
            if not sep or field not in cls._pr_cache_fields:
                continue
            try:
                number = int(number_str)
            except ValueError:
                continue
            cached_pr = cached_by_number.get(number)
            if not cached_pr:
                continue
            match field:
                case 'url':
                    cached_pr.url = value.strip() or None
                case 'title':
                    cached_pr.title = value
                case 'state':
                    cached_pr.state = value.strip() or 'OPEN'
                case 'draft':
                    cached_pr.isDraft = value.strip().lower() in {'true', 'yes', 'on', '1'}
                case 'base':
                    cached_pr.baseRefName = value.strip() or None
                case 'oid':
                    cached_pr.headRefOid = value.strip() or None
                case _:
                    pass
        return {branch: cached_by_number[number] for branch, number in branch_numbers.items()}

    def update_pr_cache(
        self,
        branch_prs: dict[str, _Github.PR],
        local_branches: set[str],
        cached_prs: dict[str, _Github.CachedPR],
    ) -> dict[str, _Github.CachedPR]:
        actual_prs = {
            branch: _Github.CachedPR(
                number=pr['number'],
                url=pr['url'],
                isDraft=pr['isDraft'],
                state=pr['state'],
                baseRefName=pr['baseRefName'],
                headRefOid=pr['headRefOid'],
                title=pr['title'],
            )
            for branch, pr in branch_prs.items()
        }

        for branch, desired_pr in actual_prs.items():
            cached_pr = cached_prs.get(branch)
            if cached_pr and (
                cached_pr.number == desired_pr.number
                and cached_pr.url == desired_pr.url
                and cached_pr.isDraft == desired_pr.isDraft
                and cached_pr.state == desired_pr.state
                and cached_pr.baseRefName == desired_pr.baseRefName
                and cached_pr.headRefOid == desired_pr.headRefOid
                and cached_pr.title == desired_pr.title
            ):
                continue

            branch_key = f'{self._branch_cache_key_prefix}{branch}{self._branch_pr_number_key_suffix}'
            if (
                subprocess.run(
                    ['git', 'config', '--local', branch_key, str(desired_pr.number)],
                    capture_output=True,
                    text=True,
                    check=False,
                ).returncode
                != 0
            ):
                continue

            pr_key_prefix = f'{self._pr_cache_key_prefix}{desired_pr.number}.'
            writes = (
                ('url', desired_pr.url or ''),
                ('title', desired_pr.title),
                ('state', desired_pr.state),
                ('draft', 'true' if desired_pr.isDraft else 'false'),
                ('base', desired_pr.baseRefName or ''),
                ('oid', desired_pr.headRefOid or ''),
            )
            if all(
                subprocess.run(
                    ['git', 'config', '--local', f'{pr_key_prefix}{field}', value],
                    capture_output=True,
                    text=True,
                    check=False,
                ).returncode
                == 0
                for field, value in writes
            ):
                cached_prs[branch] = desired_pr
            else:
                cached_prs[branch] = _Github.CachedPR(number=desired_pr.number)

        for branch in sorted((set(cached_prs) & local_branches) - set(actual_prs)):
            _ = subprocess.run(
                [
                    'git',
                    'config',
                    '--local',
                    '--unset-all',
                    f'{self._branch_cache_key_prefix}{branch}{self._branch_pr_number_key_suffix}',
                ],
                capture_output=True,
                text=True,
                check=False,
            )
            _ = cached_prs.pop(branch, None)

        return cached_prs


def _remote_for_repo(repo_name_with_owner: str) -> str | None:
    try:
        lines = _run(['git', 'remote', '-v']).splitlines()
    except subprocess.CalledProcessError:
        return None
    for line in lines:
        parts = line.split()
        if len(parts) < 2:
            continue
        remote, url = parts[:2]
        if _Github._remote_repo(url) == repo_name_with_owner:
            return remote
    return None


def _cached_pr_compare_refs(
    cached_pr: _Github.CachedPR | None,
    remotes: list[str],
) -> list[str]:
    if not cached_pr or not cached_pr.baseRefName:
        return []

    refs: list[str] = []
    if cached_pr.url and (repo := _Github._remote_repo(cached_pr.url)):
        if remote := _remote_for_repo(repo):
            refs.append(f'{remote}/{cached_pr.baseRefName}')

    refs.extend(f'{remote}/{cached_pr.baseRefName}' for remote in remotes)
    return list(dict.fromkeys(refs))


@dataclass
class _CommitInfo:
    sha: str
    summary: str
    body: list[str]

    @cached_property
    def change_id(self) -> str | None:
        return _Gerrit.get_change_id(self.body)


@dataclass
class _BranchInfo:
    name: str
    branch_line: str
    upstream: str
    upstream_track: str
    pr_line: str | None = None
    cached_pr: _Github.CachedPR | None = None
    commits: list[_CommitInfo] = field(default_factory=list)
    gerrit_lines: dict[str, list[str]] = field(default_factory=dict)

    def cached_pr_matches(self) -> bool:
        return bool(
            self.cached_pr
            and self.cached_pr.headRefOid
            and self.cached_pr.headRefOid in _branch_oids(self.name, self.upstream)
        )

    def render(
        self,
        show_gerrit_placeholders: bool = False,
        gerrit_base_url: str | None = None,
    ) -> list[str]:
        lines = [self.branch_line]
        if self.pr_line:
            lines.append(self.pr_line)
        for commit in self.commits:
            commit_line = f'  {_Ansi.GREY}·{_Ansi.END} {commit.summary}'
            if commit.sha in self.gerrit_lines:
                lines.append(commit_line)
                lines.extend(self.gerrit_lines[commit.sha])
            elif show_gerrit_placeholders and commit.change_id and gerrit_base_url:
                link = _link(
                    commit.change_id[:8],
                    f'{gerrit_base_url}/q/{commit.change_id}',
                )
                lines.append(commit_line)
                lines.append(
                    f'      {_Ansi.CYAN}{_Ansi.BOLD}gr{_Ansi.END} {link} '
                    f'{_Ansi.GREY}loading…{_Ansi.END}'
                )
            else:
                lines.append(commit_line)
        return lines


def _format_remote_ref_line(remote: str, ref: str) -> str:
    remote_part = f'{_Ansi.CYAN}{remote}:{_Ansi.END}'
    ref_part = f'{_Ansi.BLUE}{ref}{_Ansi.END}'
    return f'  {remote_part}{ref_part}'


def _commit_for_change_result(result: _Gerrit.QueryResult) -> _CommitInfo:
    change_id = result['id']
    return _CommitInfo(
        sha=result['currentPatchSet']['revision'],
        summary=result['subject'],
        body=[f'Change-Id: {change_id}'],
    )


def _remote_change_chain(
    result: _Gerrit.QueryResult,
    results_by_revision: dict[str, _Gerrit.QueryResult],
) -> list[_Gerrit.QueryResult]:
    chain: list[_Gerrit.QueryResult] = []
    seen_change_ids: set[str] = set()
    current = result
    while True:
        change_id = current['id']
        if change_id in seen_change_ids:
            break
        chain.append(current)
        seen_change_ids.add(change_id)

        parent_result = None
        for parent_revision in current['currentPatchSet'].get('parent', []):
            if parent_revision in results_by_revision:
                parent_result = results_by_revision[parent_revision]
                break
        if parent_result is None:
            break
        current = parent_result
    return chain


def _remote_change_branches(
    gerrit: _Gerrit,
    excluded_change_ids: set[str] | None = None,
) -> list[_BranchInfo]:
    excluded = excluded_change_ids or set()
    remote_name = gerrit.remote_name
    results = gerrit.open_change_results()
    ordered_results = sorted(results, key=lambda result: bool(result.get('wip')))
    results_by_revision = {
        result['currentPatchSet']['revision']: result
        for result in results
    }
    gerrit_line_cache: dict[str, list[str]] = {}
    branches: list[_BranchInfo] = []
    for result in ordered_results:
        change_id = result['id']
        if change_id in excluded:
            continue
        commits: list[_CommitInfo] = []
        gerrit_lines: dict[str, list[str]] = {}
        for related_result in _remote_change_chain(result, results_by_revision):
            related_change_id = related_result['id']
            commit = _commit_for_change_result(related_result)
            commits.append(commit)
            if related_change_id not in gerrit_line_cache:
                gerrit_line_cache[related_change_id] = gerrit.info_lines(related_change_id, commit.sha)
            gerrit_lines[commit.sha] = gerrit_line_cache[related_change_id]
        branches.append(
            _BranchInfo(
                name=f'{remote_name}:{result["currentPatchSet"]["ref"]}',
                branch_line=_format_remote_ref_line(remote_name, result['currentPatchSet']['ref']),
                upstream='',
                upstream_track='',
                commits=commits,
                gerrit_lines=gerrit_lines,
            )
        )
    return branches


_BRANCH_FORMAT = (
    '%(HEAD)\t%(refname:short)\t%(upstream:short)\t%(upstream:track)\t'
    '%(committerdate:relative)\t%(worktreepath)'
)


def _format_upstream_track(track: str) -> str:
    if track.startswith('[') and track.endswith(']'):
        track = track[1:-1]
    return track.replace('ahead ', '↑').replace('behind ', '↓').replace(', ', '')


def _format_track_part(track: str) -> str:
    if not track:
        return ''
    parts: list[str] = []
    for direction, count in cast(list[tuple[str, str]], re.findall(r'([↑↓])(\d+)', track)):
        parts.append(f'{direction}{count}')
    rendered = ''.join(parts)
    if '↑' in rendered and '↓' in rendered:
        return f'{_Ansi.RED}{rendered}{_Ansi.END}'
    return rendered


def _format_branch_line(
    head: str,
    branch: str,
    upstream: str,
    upstream_track: str,
    date: str,
    worktree_dir: str | None,
    root: str | None,
    name_width: int,
) -> str:
    short_date = re.sub(r'(\d+\s+\w+)\s+ago', r'\1', date)
    head_marker = f'{_Ansi.BOLD}{_Ansi.GREEN}{_THIS}{_Ansi.END} ' if head == '*' else '  '
    branch_color = f'{_Ansi.BOLD}{_Ansi.YELLOW}' if head == '*' else _Ansi.YELLOW
    branch_part = f'{branch_color}{branch.ljust(name_width)}{_Ansi.END}'
    extra_parts: list[str] = []
    if upstream and upstream != 'origin/main':
        extra_parts.append(f'{_Ansi.GREY}@{upstream}{_Ansi.END}')
    worktree_part = (
        f'{_Ansi.BLUE}wt:{relpath(Path(worktree_dir).resolve(), Path(root).resolve())}{_Ansi.END}'
        if worktree_dir and root
        else ''
    )
    if worktree_part:
        extra_parts.append(worktree_part)
    if track_part := _format_track_part(upstream_track):
        extra_parts.append(track_part)
    extra_parts.append(f'{_Ansi.GREY}{short_date}{_Ansi.END}')
    return head_marker + branch_part + '  ' + '  '.join(extra_parts)


def _get_branch_infos() -> list[_BranchInfo]:
    rows: list[tuple[str, str, str, str, str, str | None]] = []
    for line in _run(
        ['git', 'for-each-ref', '--sort=refname', f'--format={_BRANCH_FORMAT}', 'refs/heads']
    ).splitlines():
        head, branch, upstream, track, date, worktree_dir = (
            line.split('\t') + [''] * 6
        )[:6]
        rows.append((head, branch, upstream, track, date, worktree_dir or None))
    rows.sort(key=lambda row: row[5] is None)
    root = (
        str(Path(_run('git rev-parse --git-common-dir')).parent)
        if any(worktree_dir for *_, worktree_dir in rows)
        else None
    )

    name_width = max((len(branch) for _, branch, _, _, _, _ in rows), default=0)

    branches: list[_BranchInfo] = []
    for head, branch, upstream, upstream_track_raw, date, worktree_dir in rows:
        upstream_track = _format_upstream_track(upstream_track_raw)
        branches.append(
            _BranchInfo(
                name=branch,
                branch_line=_format_branch_line(
                    head,
                    branch,
                    upstream,
                    upstream_track,
                    date,
                    worktree_dir,
                    root,
                    name_width,
                ),
                upstream=upstream,
                upstream_track=upstream_track,
            )
        )
    return branches


def _get_default_compare_refs(remotes: list[str]) -> list[str]:
    refs: list[str] = []
    try:
        refs.extend(
            ref.strip()
            for ref in _run(
                ['git', 'for-each-ref', '--format=%(symref:short)', 'refs/remotes/*/HEAD']
            ).splitlines()
            if ref.strip()
        )
    except subprocess.CalledProcessError:
        pass

    for remote in remotes:
        refs.extend([f'{remote}/main', f'{remote}/master'])

    return list(dict.fromkeys(refs))


def _get_branch_commits_from_refs(
    branch: str,
    compare_refs: list[str],
    max_commits: int | None = None,
) -> list[_CommitInfo]:
    for compare_ref in dict.fromkeys(compare_refs):
        if not compare_ref:
            continue
        try:
            cmd = [
                'git',
                '--no-pager',
                'log',
                '--format====%H%n%s%n%b',
                f'{compare_ref}..refs/heads/{branch}',
            ]
            if max_commits is not None:
                cmd.insert(3, f'--max-count={max_commits + 1}')
            output = _run(cmd)
        except subprocess.CalledProcessError:
            continue
        commits: list[_CommitInfo] = []
        for commit in output.split('===')[1:]:
            lines = commit.strip().splitlines()
            if len(lines) < 2:
                continue
            sha, summary, *body = lines
            commits.append(_CommitInfo(sha=sha, summary=summary, body=body))
        if commits and (max_commits is None or len(commits) <= max_commits):
            return commits
    return []


def _get_branch_commits(
    branch: str,
    upstream: str,
    upstream_track: str,
    pr_fallback_compare_refs: list[str],
    cached_compare_refs: list[str] | None = None,
) -> list[_CommitInfo]:
    if cached_compare_refs:
        commits = _get_branch_commits_from_refs(branch, cached_compare_refs, max_commits=32)
        if commits:
            return commits

    if not upstream or upstream_track == 'gone':
        return []

    _, _, upstream_branch = upstream.partition('/')
    if '↑' in upstream_track:
        commits = _get_branch_commits_from_refs(branch, [upstream])
        if commits:
            return commits

    if upstream_branch != branch:
        return []
    if not pr_fallback_compare_refs:
        return []

    return _get_branch_commits_from_refs(branch, pr_fallback_compare_refs, max_commits=32)

def _render_branches(
    branches: list[_BranchInfo],
    show_gerrit_placeholders: bool = False,
    gerrit_base_url: str | None = None,
) -> list[str]:
    lines: list[str] = []
    for branch in branches:
        lines.extend(
            branch.render(
                show_gerrit_placeholders=show_gerrit_placeholders,
                gerrit_base_url=gerrit_base_url,
            )
        )
    return lines


def _render_output(
    branches: list[_BranchInfo],
    remote_branches: list[_BranchInfo],
    show_gerrit_placeholders: bool = False,
    gerrit_base_url: str | None = None,
) -> list[str]:
    lines = _render_branches(
        branches,
        show_gerrit_placeholders=show_gerrit_placeholders,
        gerrit_base_url=gerrit_base_url,
    )
    if not remote_branches:
        return lines
    lines.extend(_render_branches(remote_branches))
    return lines


def _print_lines(lines: list[str]) -> None:
    if not lines:
        return
    _ = sys.stdout.write('\n'.join(lines) + '\n')
    _ = sys.stdout.flush()


def _visible_len(line: str) -> int:
    return len(_CSI_RE.sub('', _OSC_RE.sub('', line)))


def _line_height(line: str, columns: int) -> int:
    columns = max(1, columns)
    return max(1, (_visible_len(line) + columns - 1) // columns)


def _screen_rows(lines: list[str], columns: int) -> int:
    return sum(_line_height(line, columns) for line in lines)


def _overflows_screen(lines: list[str]) -> bool:
    size = shutil.get_terminal_size(fallback=(80, 24))
    return _screen_rows(lines, size.columns) > max(1, size.lines - 1)


def _fit_to_screen(lines: list[str]) -> list[str]:
    size = shutil.get_terminal_size(fallback=(80, 24))
    max_rows = max(1, size.lines - 1)
    used_rows = 0
    fitted: list[str] = []
    for index, line in enumerate(lines):
        line_rows = _line_height(line, size.columns)
        if used_rows + line_rows > max_rows:
            if not fitted:
                fitted.append(f'  {_Ansi.GREY}... {len(lines) - index} more loading{_Ansi.END}')
                break
            while fitted:
                remaining = len(lines) - len(fitted)
                marker = f'  {_Ansi.GREY}... {remaining} more loading{_Ansi.END}'
                if used_rows + _line_height(marker, size.columns) <= max_rows:
                    fitted.append(marker)
                    break
                removed = fitted.pop()
                used_rows -= _line_height(removed, size.columns)
            break
        fitted.append(line)
        used_rows += line_rows
    return fitted


def _replace_block(previous_rows: int, lines: list[str]) -> int:
    size = shutil.get_terminal_size(fallback=(80, 24))
    if previous_rows > 0:
        _ = sys.stdout.write(f'\033[{previous_rows}A')
    _ = sys.stdout.write('\r\033[J')
    if lines:
        _print_lines(lines)
    else:
        _ = sys.stdout.flush()
    return _screen_rows(lines, size.columns)


def _enter_alternate_screen() -> None:
    _ = sys.stdout.write('\033[?1049h\033[H\033[J')
    _ = sys.stdout.flush()


def _exit_alternate_screen() -> None:
    _ = sys.stdout.write('\033[?1049l')
    _ = sys.stdout.flush()


def _redraw_progress(
    current_rows: int,
    current_lines: list[str],
    lines: list[str],
    use_alternate_screen: bool,
) -> tuple[int, list[str], bool]:
    if not use_alternate_screen and _overflows_screen(lines):
        current_rows = _replace_block(current_rows, [])
        _enter_alternate_screen()
        use_alternate_screen = True

    next_lines = _fit_to_screen(lines)
    if next_lines == current_lines:
        return current_rows, current_lines, use_alternate_screen

    current_rows = _replace_block(current_rows, next_lines)
    return current_rows, next_lines, use_alternate_screen


def main():
    parser = argparse.ArgumentParser(description='Display Git branches with PR and Gerrit info')
    _ = parser.add_argument(
        '-r',
        '--remote',
        action='store_true',
        help='Also include other open Gerrit changes from the remote',
    )
    args = parser.parse_args()

    gerrit_base_url = _Gerrit.origin_base_url()
    try:
        remotes = [remote.strip() for remote in _run(['git', 'remote']).splitlines() if remote.strip()]
    except subprocess.CalledProcessError:
        remotes = []
    default_compare_refs = _get_default_compare_refs(remotes)
    branches = _get_branch_infos()
    local_branch_names = {branch.name for branch in branches}
    cached_prs = _Github.cached_prs(local_branch_names)
    for branch in branches:
        branch.cached_pr = cached_prs.get(branch.name)

    interactive = sys.stdout.isatty()
    current_rows = 0
    current_lines: list[str] = []
    use_alternate_screen = False
    remote_branches: list[_BranchInfo] = []

    try:
        max_workers = min(16, max(4, len(branches) + 2))
        with ThreadPoolExecutor(max_workers=max_workers) as executor:
            github_future = executor.submit(_Github.init)
            gerrit_future = executor.submit(_Gerrit.init)
            branch_prs: dict[str, _Github.PR] = {}
            commit_futures: dict[str, Future[list[_CommitInfo]]] = {}
            for branch in branches:
                cached_pr_matches = branch.cached_pr_matches()
                cached_compare_refs = (
                    _cached_pr_compare_refs(branch.cached_pr, remotes)
                    if cached_pr_matches
                    else []
                )
                pr_fallback_compare_refs = default_compare_refs if cached_pr_matches else []
                commit_futures[branch.name] = executor.submit(
                    _get_branch_commits,
                    branch.name,
                    branch.upstream,
                    branch.upstream_track,
                    pr_fallback_compare_refs,
                    cached_compare_refs,
                )

            for branch in branches:
                branch.commits.extend(commit_futures[branch.name].result())

            github = github_future.result() if github_future.done() else None
            if github:
                branch_prs = {
                    branch.name: pr
                    for branch in branches
                    if (pr := github.pr_for_branch(branch.name, branch.upstream))
                }
                for branch in branches:
                    pr = branch_prs.get(branch.name)
                    branch.pr_line = (
                        github.format_pr_line(
                            pr['number'],
                            pr['url'],
                            pr['isDraft'],
                            pr['state'],
                            pr['title'],
                        )
                        if pr
                        else None
                    )
                _ = executor.submit(github.update_pr_cache, branch_prs, local_branch_names, cached_prs)
            else:
                for branch in branches:
                    if not branch.cached_pr:
                        continue
                    if (
                        branch.cached_pr.number is not None
                        and branch.cached_pr.url
                        and branch.cached_pr_matches()
                    ):
                        branch.pr_line = _Github.format_pr_line(
                            branch.cached_pr.number,
                            branch.cached_pr.url,
                            branch.cached_pr.isDraft,
                            branch.cached_pr.state,
                            branch.cached_pr.title,
                        )
                    else:
                        branch.pr_line = (
                            f'  {_Ansi.CYAN}{_Ansi.BOLD}gh{_Ansi.END} {_Ansi.GREY}loading…{_Ansi.END}'
                        )

            if interactive:
                current_rows, current_lines, use_alternate_screen = _redraw_progress(
                    current_rows,
                    current_lines,
                    _render_output(
                        branches,
                        remote_branches,
                        show_gerrit_placeholders=True,
                        gerrit_base_url=gerrit_base_url,
                    ),
                    use_alternate_screen,
                )

            if github is None:
                github = github_future.result()
                if github:
                    branch_prs = {
                        branch.name: pr
                        for branch in branches
                        if (pr := github.pr_for_branch(branch.name, branch.upstream))
                    }
                    for branch in branches:
                        pr = branch_prs.get(branch.name)
                        branch.pr_line = (
                            github.format_pr_line(
                                pr['number'],
                                pr['url'],
                                pr['isDraft'],
                                pr['state'],
                                pr['title'],
                            )
                            if pr
                            else None
                        )
                    _ = executor.submit(github.update_pr_cache, branch_prs, local_branch_names, cached_prs)

            pr_check_futures: dict[str, Future[_Github.CheckSummary | None]] = {}
            pr_comment_futures: dict[str, Future[int | None]] = {}
            pr_commit_futures: dict[str, Future[list[_CommitInfo]]] = {}
            if github:
                base_remote = github.base_remote
                for branch in branches:
                    pr = branch_prs.get(branch.name)
                    if not pr:
                        continue
                    pr_check_futures[branch.name] = executor.submit(github.get_pr_checks, pr['number'])
                    if pr['state'] == 'OPEN':
                        pr_comment_futures[branch.name] = executor.submit(
                            github.get_pr_unresolved_comments, pr['number']
                        )
                    compare_refs: list[str] = []
                    if base_remote:
                        compare_refs.append(f'{base_remote}/{pr["baseRefName"]}')
                    if branch.upstream and branch.upstream_track != 'gone':
                        compare_refs.append(branch.upstream)
                    pr_commit_futures[branch.name] = executor.submit(
                        _get_branch_commits_from_refs,
                        branch.name,
                        compare_refs,
                    )

            for branch in branches:
                future = pr_commit_futures.get(branch.name)
                if future is not None:
                    branch.commits = future.result()

            if interactive:
                current_rows, current_lines, use_alternate_screen = _redraw_progress(
                    current_rows,
                    current_lines,
                    _render_output(
                        branches,
                        remote_branches,
                        show_gerrit_placeholders=True,
                        gerrit_base_url=gerrit_base_url,
                    ),
                    use_alternate_screen,
                )

            if github:
                for branch in branches:
                    pr = branch_prs.get(branch.name)
                    if not pr:
                        branch.pr_line = None
                        continue
                    check_summary = None
                    if future := pr_check_futures.get(branch.name):
                        check_summary = future.result()
                    unresolved_comments = None
                    if future := pr_comment_futures.get(branch.name):
                        unresolved_comments = future.result()
                    branch.pr_line = github.format_pr_line(
                        pr['number'],
                        pr['url'],
                        pr['isDraft'],
                        pr['state'],
                        pr['title'],
                        unresolved_comments,
                        check_summary,
                    )

            if interactive:
                current_rows, current_lines, use_alternate_screen = _redraw_progress(
                    current_rows,
                    current_lines,
                    _render_output(
                        branches,
                        remote_branches,
                        show_gerrit_placeholders=True,
                        gerrit_base_url=gerrit_base_url,
                    ),
                    use_alternate_screen,
                )

            gerrit = gerrit_future.result()
            if gerrit:
                change_ids = [cid for b in branches for c in b.commits if (cid := c.change_id)]
                gerrit.prefetch_change_ids(change_ids)
                for branch in branches:
                    for commit in branch.commits:
                        if commit.sha not in branch.gerrit_lines and (changeid := commit.change_id):
                            branch.gerrit_lines[commit.sha] = gerrit.info_lines(changeid, commit.sha)
                if bool(getattr(args, 'remote', False)):
                    remote_branches = _remote_change_branches(gerrit, set(change_ids))
    finally:
        final_lines = _render_output(branches, remote_branches)
        if interactive:
            if use_alternate_screen:
                _exit_alternate_screen()
                _print_lines(final_lines)
            else:
                _ = _replace_block(current_rows, final_lines)
        else:
            _print_lines(final_lines)


if __name__ == '__main__':
    main()
