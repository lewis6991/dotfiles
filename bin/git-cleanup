#! /usr/bin/env bash

main_worktree=$(git worktree list --porcelain | sed -n '1s/^worktree //p')

git for-each-ref --shell --format="%(refname:short)" refs/heads |
    while read -r entry; do
        branch=$(echo "$entry" | xargs)  # Unquote
        upstream_track=$(git branch --list "$branch" --format='%(upstream:track)')
        [[ "$upstream_track" == "[gone]" ]] || continue

        worktree_path=$(git branch --list "$branch" --format='%(worktreepath)')
        if [[ -n "$worktree_path" ]]; then
            if [[ "$worktree_path" == "$main_worktree" ]]; then
                echo "Skipping $branch: checked out in main worktree at $worktree_path" >&2
                continue
            fi

            # Match branch -D: gone branches are cleanup targets, including linked worktrees.
            git worktree remove --force "$worktree_path" || continue
        fi

        git branch -D "$branch"
    done
